<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Contril Adaptive Icon Foreground — LIGHT THEME
        Source of truth: public/favicon.svg
        
        favicon.svg geometry (48x48 viewBox):
          circle cx=24 cy=24 r=18 stroke=#2563EB stroke-width=2.5
          diamond path M24,13.5 L34.5,24 L24,34.5 L13.5,24 Z stroke=#2563EB stroke-width=2.5

        Scaled to 108dp adaptive icon canvas (center at 54,54):
          Scale factor: 108/48 = 2.25
          But we use the 66dp safe zone (21dp inset each side), so we
          center the symbol at (54,54) and scale the favicon proportionally
          to fit within the 66dp (from 21 to 87) safe area with padding.
          
          Effective usable radius: ~28dp (leaving breathing room in 33dp half-safe-zone)
          Circle radius in favicon: 18/48 * 66 ≈ 24.75 → use 23
          Diamond half in favicon: 10.5/48 * 66 ≈ 14.4375 → use 14
    -->

    <!-- Contril Outer Ring (matches favicon circle) -->
    <path
        android:strokeColor="#2563EB"
        android:strokeWidth="2.8"
        android:fillColor="#00000000"
        android:pathData="M 54,31 A 23,23 0 1,0 54,77 A 23,23 0 1,0 54,31" />

    <!-- Contril Core Diamond (matches favicon diamond, filled blue) -->
    <path
        android:strokeColor="#2563EB"
        android:strokeWidth="2.5"
        android:strokeLineJoin="miter"
        android:fillColor="#2563EB"
        android:pathData="M 54,40 L 68,54 L 54,68 L 40,54 Z" />
</vector>
